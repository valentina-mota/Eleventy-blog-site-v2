---
title: Archive
layout: "base.njk"
---

{# Collect unique categories #}
{% set categories = [] %}
{% for post in collections.post %}
  {% if post.data.category and post.data.category not in categories %}
    {% set categories = (categories.push(post.data.category), categories) %}
  {% endif %}
{% endfor %}

<section class="archive-section">
  <div class="container">

    <div class="archive-header">
      <p class="hero-kicker">All articles</p>
      <h1 class="section-heading">Archive</h1>
    </div>

    <div class="content-grid">

      <!-- Posts column -->
      <div class="posts-area">
        <div class="archive-toolbar">
          <input
            type="text"
            id="archive-search"
            placeholder="Search articles…"
            aria-label="Search articles"
          />
        </div>
        <p id="archive-count" class="archive-count"></p>

        <ul role="list" class="archive-list" id="posts-list">
          {%- for post in collections.post | reverse -%}
            {% include "article-snippet.njk" %}
          {%- endfor %}
        </ul>

        <p class="archive-empty" id="empty-state" style="display:none">
          No articles found.
        </p>
      </div>

      <!-- Sidebar -->
      {% include "sidebar.njk" %}

    </div>
  </div>
</section>

<script src="/assets/filter.js"></script>

      <div class="guest-author-info">
        <strong class="guest-author-name">Veronica Paolucci</strong>
        <span class="guest-author-role">Cybersecurity Specialist</span>
      </div>
    </div>
    <p class="guest-author-bio">
      Veronica writes and talks about cybersecurity in plain language, from phishing
      to AI threats, from real hacking cases to digital self-defence.
    </p>
    <button class="category-btn guest-category-btn" data-category="cyber security">
      Read Veronica's articles
    </button>
      </div> -->

      <a href="/blog/" class="hero-panel-link">Browse all articles →</a>
    </aside>

  </div>
</section>

<!-- ═══════════════════════════════════════════ FEATURED -->
<section class="featured-section" id="featured-posts">
  <div class="container">

    <div class="featured-header">
      <div>
        <p class="section-kicker">Editorial selection</p>
        <h2 class="section-heading">Featured posts</h2>
      </div>
      <a href="/blog/" class="featured-archive-link">View all →</a>
    </div>

    <div class="featured-grid">
      {%- for post in collections.featured | reverse -%}
        {% include "article-featured.njk" %}
      {%- endfor %}
    </div>

  </div>
</section>


<li class="archive-card" data-category="{{ post.data.category }}">
  <img
    src="{{ post.data.image }}"
    alt="{{ post.data.imageAlt }}"
    class="archive-card-image"
    loading="lazy"
  />
  <div class="archive-card-content">
    <div class="post-meta">
      {% if post.data.category %}
        <span class="post-category">{{ post.data.category }}</span>
      {% endif %}
      {% if post.data.guest %}
        <span class="post-guest">✍ {{ post.data.guest.name }}</span>
      {% endif %}
    </div>
    <h3 class="archive-card-title">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </h3>
    <p class="archive-card-excerpt">{{ post.data.description }}</p>
    <a href="{{ post.url }}" class="read-more">Continue reading</a>
  </div>
</li>

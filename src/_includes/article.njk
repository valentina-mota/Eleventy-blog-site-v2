---
layout: "base.njk"
---

<article class="main-article">
  <div class="container container--narrow flow">
    <h1 class="article-title">
      {{ title }}
    </h1>
    <figure class="main-article__figure">
      <img src="{{ image }}" alt="{{ imageAlt }}" />
      <figcaption>{{ imageAlt }}</figcaption>
    </figure>

    {{ content | safe }}

    {% if guest %}
    <div class="article-guest-author">
      <div class="guest-author">
        <img
          src="/assets/{{ guest.photo }}"
          alt="{{ guest.name }}"
          class="guest-author-photo"
        />
        <div class="guest-author-info">
          <strong class="guest-author-name">{{ guest.name }}</strong>
          <span class="guest-author-role">{{ guest.role }}</span>
        </div>
      </div>
      <p class="guest-author-bio">{{ guest.bio }}</p>
      {% if guest.youtube or guest.substack %}
      <div class="guest-author-links">
        {% if guest.youtube %}
          <a href="{{ guest.youtube }}" target="_blank" rel="noopener" class="guest-link guest-link-yt">▶ YouTube</a>
        {% endif %}
        {% if guest.substack %}
          <a href="{{ guest.substack }}" target="_blank" rel="noopener" class="guest-link guest-link-sub">✉ Substack</a>
        {% endif %}
      </div>
      {% endif %}
    </div>
    {% endif %}

  </div>
</article>

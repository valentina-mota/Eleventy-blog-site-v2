---
title: VM WebDev Techblog
layout: "base.njk"
---

<!-- ═══════════════════════════════════════════ HERO -->
<section class="hero">
  <div class="container hero-grid">

    <!-- Left: image + title + CTA -->
    <div class="hero-left">
      <div class="hero-image-wrap">
        <img
          src="/assets/blog/blog-cover_hero-panel.png"
          alt="Old Classic Computer On Retro Desk"
          class="hero-img"
        />
      </div>
      <div class="hero-body">
        <p class="hero-kicker">Frontend notes, essays &amp; experiments</p>
        <h1 class="hero-title">
          Writing about the web,<br>
          <em>one post at a time</em>
        </h1>
        <p class="hero-text">
          A space for articles on frontend development, web design,
          performance and digital culture.
        </p>
        <a href="#featured-posts" class="btn-hero">Read featured posts</a>
      </div>
    </div>

    <!-- Right: dark panel with recent posts -->
    <aside class="hero-panel">
      <h2 class="hero-panel-title">New</h2>
      <ul class="hero-panel-list">
        {%- for post in collections.post | reverse -%}
          {%- if loop.index <= 3 -%}
          <li class="hero-panel-item">
            <a href="{{ post.url }}">
              <span class="hero-panel-post-title">{{ post.data.title }}</span>
              <span class="hero-panel-post-desc">{{ post.data.description | truncate(80) }}</span>
            </a>
          </li>
          {%- endif -%}
        {%- endfor %}
      </ul>
      <a href="/blog/" class="hero-panel-link">Browse all articles →</a>
    </aside>

  </div>
</section>

<!-- ═══════════════════════════════════════════ FEATURED + SIDEBAR -->
<section class="featured-section" id="featured-posts">
  <div class="container featured-with-sidebar">

    <!-- Main: featured grid -->
    <div class="featured-main">
      <div class="featured-header">
        <div>
          <p class="section-kicker">Editorial selection</p>
          <h2 class="section-heading">Featured posts</h2>
        </div>
        <a href="/blog/" class="featured-archive-link">View all →</a>
      </div>

      <div class="featured-grid" id="featured-grid">
        {%- for post in collections.featured | reverse -%}
          {% include "article-featured.njk" %}
        {%- endfor %}
      </div>

      <p class="archive-empty" id="featured-empty" style="display:none">
        No articles found for this selection.
      </p>
    </div>

    <!-- Sidebar -->
    {% include "sidebar-home.njk" %}

  </div>
</section>

<script src="/assets/filter-home.js"></script>
